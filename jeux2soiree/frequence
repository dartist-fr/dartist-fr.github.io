<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Fréquence — Salle d'Arcade</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b0616;
            --card-bg: #140a26;
            --grid-line: rgba(34, 230, 255, 0.10);
            --border-color: rgba(34, 230, 255, 0.35);
            --text-main: #f3e9ff;
            --text-sub: #9d8bc4;
            --accent: #22e6ff;
            --accent-glow: rgba(34, 230, 255, 0.25);
            --neon-pink: #ff2e88;
            --neon-yellow: #ffe14d;
            --neon-green: #4dffa6;
            --font-display: 'Press Start 2P', monospace;
            --font-body: 'VT323', monospace;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { background: var(--bg-color); }
        body {
            font-family: var(--font-body);
            background-color: var(--bg-color);
            background-image:
                linear-gradient(var(--grid-line) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
                radial-gradient(circle at 50% 0%, rgba(34, 230, 255, 0.15) 0%, transparent 55%);
            background-size: 40px 40px, 40px 40px, 100% 100%;
            color: var(--text-main);
            min-height: 100vh;
            padding: 16px 12px 50px;
            position: relative;
            font-size: 1.25rem;
        }

        body::after {
            content: "";
            position: fixed; inset: 0; pointer-events: none;
            background: repeating-linear-gradient(to bottom, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px, rgba(0,0,0,0.18) 3px, rgba(0,0,0,0.18) 4px);
            z-index: 100; mix-blend-mode: multiply;
        }

        .top-bar { max-width: 560px; margin: 0 auto 16px; display: flex; justify-content: space-between; align-items: center; }
        .btn-back, .btn-fs {
            display: inline-flex; align-items: center; gap: 6px;
            font-family: var(--font-display); font-size: 0.45rem;
            color: var(--accent); text-decoration: none;
            padding: 8px 12px; border: 2px solid var(--accent);
            background: rgba(34, 230, 255, 0.06); cursor: pointer;
            box-shadow: 0 0 0 2px var(--bg-color), 3px 3px 0 rgba(34, 230, 255, 0.35);
        }

        .container {
            max-width: 560px; margin: 0 auto;
            background: var(--card-bg); border: 2px solid var(--accent);
            padding: 20px 16px;
            box-shadow: 0 0 0 4px var(--bg-color), 6px 6px 0 rgba(0,0,0,0.6), 0 0 25px rgba(34,230,255,0.2);
            position: relative; z-index: 10;
        }

        h1 {
            font-family: var(--font-display); font-size: 1rem; line-height: 1.4; text-align: center;
            color: var(--accent); text-shadow: 0 0 8px rgba(34,230,255,0.9), 2px 2px 0 #0a3d4a;
            margin-bottom: 10px;
        }

        .phase-subtitle { text-align: center; font-size: 1.1rem; color: var(--text-sub); margin-bottom: 16px; }

        .panel { background: rgba(0,0,0,0.35); border: 2px solid var(--border-color); padding: 14px; margin-bottom: 14px; text-align: center; }
        .panel h2 { font-family: var(--font-display); font-size: 0.55rem; color: var(--text-sub); margin-bottom: 10px; }

        /* --- Design optimisé mobile pour éviter les superpositions --- */
        .spectrum-container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
            color: #fff;
            background: rgba(34, 230, 255, 0.08);
            border: 2px solid var(--accent);
            padding: 10px 14px;
            margin-bottom: 16px;
            border-radius: 4px;
            text-shadow: 0 0 6px rgba(34, 230, 255, 0.5);
            word-break: break-word;
        }
        .spectrum-container span {
            color: var(--neon-yellow);
            flex: 1;
            text-align: center;
        }
        .spectrum-container span:first-child { text-align: left; }
        .spectrum-container span:last-child { text-align: right; }

        .gauge-box {
            position: relative; background: #07040f; border: 2px solid var(--accent);
            height: 50px; border-radius: 4px; margin: 20px 0; display: flex; align-items: center;
        }

        input[type=range] {
            position: absolute; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 5;
        }

        .gauge-track {
            position: absolute; width: 100%; height: 10px; background: #222; top: 50%; transform: translateY(-50%);
        }

        .target-zone {
            position: absolute; width: 20%; height: 100%; background: rgba(77, 255, 166, 0.3);
            border-left: 2px dashed #4dffa6; border-right: 2px dashed #4dffa6; top: 0; transition: left 0.3s;
        }

        .cursor-line {
            position: absolute; width: 4px; height: 120%; background: var(--neon-pink);
            top: -10%; transform: translateX(-50%); box-shadow: 0 0 8px var(--neon-pink);
            pointer-events: none; transition: left 0.05s linear; z-index: 2;
        }

        input[type="text"] {
            width: 100%; background: #07040f; border: 2px solid var(--border-color);
            color: #fff; padding: 10px; font-size: 1.2rem; outline: none; font-family: var(--font-body);
            text-align: center; margin-top: 8px;
        }

        .btn {
            display: flex; align-items: center; justify-content: center; width: 100%;
            padding: 12px; font-family: var(--font-display); font-size: 0.55rem;
            cursor: pointer; border: none; box-shadow: 3px 3px 0 rgba(0,0,0,0.6);
            line-height: 1.4; text-align: center; margin-top: 12px;
        }
        .btn-primary { background: var(--accent); color: #000; text-shadow: 0 0 6px rgba(255,255,255,0.3); }

        .score-display {
            font-family: var(--font-display); font-size: 1.3rem; color: var(--neon-yellow);
            text-shadow: 0 0 10px rgba(255,225,77,0.5); margin: 12px 0;
        }

        .rule-box {
            text-align: left; font-size: 1.05rem; color: var(--text-sub); line-height: 1.4; margin-bottom: 10px;
        }
        .rule-box strong { color: var(--accent); }
    </style>
</head>
<body>

    <div class="top-bar">
        <a href="../" class="btn-back">&lsaquo; HUB</a>
        <button type="button" id="btn-fullscreen" class="btn-fs">PLEIN ÉCRAN</button>
    </div>

    <main class="container" id="app"></main>

    <script>
        const PAIRES_SPECTRUM = [
            { left: "Froid", right: "Chaud" },
            { left: "Inutile", right: "Indispensable" },
            { left: "Moche", right: "Beau" },
            { left: "Léger", right: "Lourd" },
            { left: "Silencieux", right: "Bruyant" },
            { left: "Dangereux", right: "Sûr" },
            { left: "Hasardeux", right: "Prévisible" },
            { left: "Normal", right: "Bizarre" },
            { left: "Passé", right: "Futur" },
            { left: "Sous-estimé", right: "Sur-estimé" },
            { left: "Triste", right: "Joyeux" },
            { left: "Complexe", right: "Simple" }
        ];

        let state = {
            screen: "setup",
            scoreTotal: 0,
            paireActuelle: null,
            targetPosition: 50,
            indice: "",
            guessPosition: 50,
            pointsGagnes: 0
        };

        function lancerManche() {
            state.paireActuelle = PAIRES_SPECTRUM[Math.floor(Math.random() * PAIRES_SPECTRUM.length)];
            state.targetPosition = Math.floor(Math.random() * 101);
            state.guessPosition = 50;
            state.indice = "";
            state.screen = "medium_secret";
            render();
        }

        function render() {
            const app = document.getElementById("app");

            if (state.screen === "setup") {
                app.innerHTML = `
                    <h1>FRÉQUENCE</h1>
                    <p class="phase-subtitle">Lire dans les pensées</p>
                    <div class="panel">
                        <h2>Règles du jeu</h2>
                        <div class="rule-box">
                            1. Un <strong>Médium</strong> découvre une position secrète sur une jauge de gauche à droite.<br><br>
                            2. Le Médium donne un <strong>indice textuel</strong> unique pour guider son équipe.<br><br>
                            3. L'équipe discute et place le curseur pour viser le plus près possible de la cible !
                        </div>
                        <button class="btn btn-primary" onclick="lancerManche()">Commencer la partie ›</button>
                    </div>
                `;
            }
            else if (state.screen === "medium_secret") {
                app.innerHTML = `
                    <h1>Phase 1 : Le Médium</h1>
                    <p class="phase-subtitle">Découverte de la cible secrète</p>
                    <div class="panel">
                        <h2>Spectre de cette manche</h2>
                        <div class="spectrum-container">
                            <span>◀ ${state.paireActuelle.left}</span>
                            <span>${state.paireActuelle.right} ▶</span>
                        </div>
                        <div style="background:#07040f; border:2px solid var(--accent); padding:12px; margin:12px 0;">
                            <p style="font-size:0.85rem; color:var(--text-sub);">Position exacte de la cible secrète :</p>
                            <h2 style="font-size:1.6rem; color:var(--neon-pink); margin-top:4px;">${state.targetPosition}%</h2>
                        </div>
                        <p style="font-size:1rem; color:var(--text-sub);">Passez discrètement le téléphone au Médium, puis cliquez ci-dessous.</p>
                    </div>
                    <button class="btn btn-primary" onclick="state.screen='medium_indice'; render();">Le Médium a mémorisé ›</button>
                `;
            }
            else if (state.screen === "medium_indice") {
                app.innerHTML = `
                    <h1>Phase 2 : L'Indice</h1>
                    <p class="phase-subtitle">Trouvez l'inspiration</p>
                    <div class="panel">
                        <h2>Rappel du spectre</h2>
                        <div class="spectrum-container">
                            <span>◀ ${state.paireActuelle.left}</span>
                            <span>${state.paireActuelle.right} ▶</span>
                        </div>
                        <p style="color:var(--neon-yellow); font-size:0.95rem; margin:8px 0;">Cible secrète : <strong>${state.targetPosition}%</strong></p>
                        <p style="font-size:1rem; margin-top:10px;">Écrivez un indice textuel pour orienter votre équipe :</p>
                        <input type="text" id="inputIndice" placeholder="Ex: Le café, Un rocher..." value="${state.indice}" oninput="state.indice = this.value">
                    </div>
                    <button class="btn btn-primary" onclick="if(state.indice.trim()){ state.screen='equipe_guess'; render(); } else { alert('Veuillez entrer un indice !'); }">Valider et passer à l'équipe ›</button>
                `;
            }
            else if (state.screen === "equipe_guess") {
                app.innerHTML = `
                    <h1>Phase 3 : L'Équipe</h1>
                    <p class="phase-subtitle">Débattez et placez le curseur</p>
                    <div class="panel">
                        <h2>Indice du Médium</h2>
                        <p style="font-size:1.4rem; color:var(--accent); margin:8px 0;">« ${state.indice} »</p>
                        
                        <div class="spectrum-container" style="margin-top:14px;">
                            <span>◀ ${state.paireActuelle.left}</span>
                            <span>${state.paireActuelle.right} ▶</span>
                        </div>

                        <div class="gauge-box">
                            <div class="gauge-track"></div>
                            <div class="cursor-line" id="cursorLine" style="left: ${state.guessPosition}%;"></div>
                            <input type="range" min="0" max="100" value="${state.guessPosition}" oninput="state.guessPosition = this.value; document.getElementById('cursorLine').style.left = this.value + '%';">
                        </div>
                        <p style="font-size:0.9rem; color:var(--text-sub);">Glissez le curseur selon votre interprétation.</p>
                    </div>
                    <button class="btn btn-primary" onclick="calculerScore()">Valider notre choix 🎯</button>
                `;
            }
            else if (state.screen === "resultat") {
                app.innerHTML = `
                    <h1>Résultat de la manche</h1>
                    <p class="phase-subtitle">Révélation de la fréquence</p>
                    <div class="panel">
                        <div class="spectrum-container">
                            <span>◀ ${state.paireActuelle.left}</span>
                            <span>${state.paireActuelle.right} ▶</span>
                        </div>

                        <div class="gauge-box">
                            <div class="gauge-track"></div>
                            <div class="target-zone" style="left: ${Math.max(0, state.targetPosition - 10)}%; width: 20%;"></div>
                            <div class="cursor-line" style="left: ${state.guessPosition}%; background:var(--neon-yellow);"></div>
                        </div>

                        <p style="font-size:1.05rem; margin-top:8px;">Cible réelle : <strong style="color:#4dffa6">${state.targetPosition}%</strong> | Votre choix : <strong>${state.guessPosition}%</strong></p>
                        
                        <div class="score-display">+${state.pointsGagnes} Points !</div>
                        <p style="font-size:0.95rem; color:var(--text-sub);">Score cumulé : ${state.scoreTotal}</p>
                    </div>
                    <button class="btn btn-primary" onclick="lancerManche()">Manche suivante ⟳</button>
                `;
            }
        }

        function calculerScore() {
            let difference = Math.abs(state.targetPosition - state.guessPosition);
            
            if (difference <= 3) {
                state.pointsGagnes = 4;
            } else if (difference <= 8) {
                state.pointsGagnes = 3;
            } else if (difference <= 15) {
                state.pointsGagnes = 2;
            } else {
                state.pointsGagnes = 0;
            }

            state.scoreTotal += state.pointsGagnes;
            state.screen = "resultat";
            render();
        }

        document.getElementById('btn-fullscreen').addEventListener('click', function () {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
                this.textContent = "QUITTER";
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
                this.textContent = "PLEIN ÉCRAN";
            }
        });

        render();
    </script>
</body>
</html>
